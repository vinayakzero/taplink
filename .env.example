# TapLink Environment Configuration

# Database Connection (PostgreSQL / Supabase)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public
# Or for local development with PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taplink?schema=public"

# Base Application URL
NEXT_PUBLIC_APP_URL="https://taplink.in"

# JWT Secret for Session & Admin Auth
JWT_SECRET="taplink_super_secret_jwt_key_change_in_production_2026_xyz"

# Default Admin Credentials (used for initial seed/login)
ADMIN_EMAIL="admin@taplink.in"
ADMIN_PASSWORD="TapLinkAdmin2026!"
